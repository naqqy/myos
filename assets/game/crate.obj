# Unit crate: a cube with one full texture per face.
# Faces are counter-clockwise seen from outside (standard OBJ winding).
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1

vt 0 0
vt 1 0
vt 1 1
vt 0 1

# front (+Z)
f 1/1 2/2 3/3 4/4
# back (-Z)
f 6/1 5/2 8/3 7/4
# right (+X)
f 2/1 6/2 7/3 3/4
# left (-X)
f 5/1 1/2 4/3 8/4
# top (+Y)
f 4/1 3/2 7/3 8/4
# bottom (-Y)
f 5/1 6/2 2/3 1/4
